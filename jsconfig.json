{
	"compilerOptions": {
		"module": "ESNext",
		"target": "ESNext",
		"moduleResolution": "Node",
		"baseUrl": "src",
		"resolveJsonModule": true,
		"checkJs": false
	},
	"include": [
		"src/**/*.js",
		"scripts/**/*.js",
		"scripts/**/*.mjs"
	],
	"exclude": [
		"node_modules",
		"dist",
		"src/dashboard",
		"src/temporal"
	]
}
