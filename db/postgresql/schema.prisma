generator client {
    provider        = "prisma-client-js"
    // Engine-level query spans for Sentry's prismaIntegration. Without this
    // the integration installs and silently produces nothing: tracing is a
    // preview feature on Prisma 5, and the engine never emits spans unless it
    // is turned on here.
    previewFeatures = ["tracing"]
}

datasource db {
    provider = "postgresql"
    url      = env("DB_CONNECTION_URL")
}

model ArchivedChannel {
    channelId String   @db.VarChar(19)
    createdAt DateTime @default(now())
    name      String
    ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
    ticketId  String   @db.VarChar(19)

    @@id([ticketId, channelId])
    @@unique([ticketId, channelId])
    @@map("archivedChannels")
}

model ArchivedMessage {
    author    ArchivedUser @relation(fields: [ticketId, authorId], references: [ticketId, userId], onDelete: Cascade)
    authorId  String       @db.VarChar(19)
    content   String       @db.Text
    createdAt DateTime     @default(now())
    deleted   Boolean      @default(false)
    edited    Boolean      @default(false)
    external  Boolean      @default(false)
    id        String       @id @db.VarChar(19)
    ticket    Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
    ticketId  String       @db.VarChar(19)

    @@map("archivedMessages")
}

model ArchivedRole {
    archivedUsers ArchivedUser[]
    colour        String         @default("5865F2") @db.Char(6) // 7289DA 
    createdAt     DateTime       @default(now())
    name          String
    roleId        String         @db.VarChar(19)
    ticket        Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
    ticketId      String         @db.VarChar(19)

    @@id([ticketId, roleId])
    @@unique([ticketId, roleId])
    @@map("archivedRoles")
}

model ArchivedUser {
    archivedMessages ArchivedMessage[]
    avatar           String?
    bot              Boolean           @default(false)
    createdAt        DateTime          @default(now())
    discriminator    String?           @db.Char(4)
    displayName      String?           @db.Text
    role             ArchivedRole?     @relation(fields: [ticketId, roleId], references: [ticketId, roleId], onDelete: Cascade)
    roleId           String?           @db.VarChar(19)
    ticket           Ticket            @relation(fields: [ticketId], references: [id], onDelete: Cascade)
    ticketId         String            @db.VarChar(19)
    userId           String            @db.VarChar(19)
    username         String?           @db.Text

    @@id([ticketId, userId])
    @@unique([ticketId, userId])
    @@map("archivedUsers")
}

model Automation {
    createdAt   DateTime        @default(now())
    // Not a User relation, for the same reason as Panel.createdById: User rows
    // only exist for ticket participants.
    createdById String?         @db.VarChar(19)
    enabled     Boolean         @default(true)
    // { version, nodes[], edges[] } — see src/lib/automations/validate.js.
    graph       Json
    guild       Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
    guildId     String          @db.VarChar(19)
    id          Int             @id @default(autoincrement())
    // Short, stable, per-guild-unique handle. Used in button custom_ids (where
    // Discord's 100-char budget is already tight) and in Temporal schedule ids,
    // so it is deliberately not the autoincrement pk.
    key         String          @db.VarChar(12)
    name        String          @db.VarChar(100)
    runs        AutomationRun[]
    // The distinct trigger types in the graph, derived server-side on every
    // write. An automation may hold several triggers, so this is a list.
    //
    // Display and coarse filtering only: the dispatcher matches against the
    // graph's own trigger nodes (it already holds the whole guild in memory), so
    // this is never what decides whether an automation fires.
    triggerTypes Json
    updatedAt   DateTime        @updatedAt

    @@unique([guildId, key])
    @@index([guildId, enabled])
    @@map("automations")
}

model AutomationRun {
    automation   Automation          @relation(fields: [automationId], references: [id], onDelete: Cascade)
    automationId Int
    createdAt    DateTime            @default(now())
    durationMs   Int?
    // A machine code (`step_budget_exceeded`, `missing_permissions`, …) and the
    // node it happened on. Never a raw stack — this is shown in the dashboard.
    error        String?             @db.Text
    finishedAt   DateTime?
    guildId      String              @db.VarChar(19)
    id           String              @id @default(uuid())
    // Compact per-node trace, capped at LIMITS.steps entries:
    // [{ n: "n3", t: "action.role.add", s: "ok", ms: 41 }, …]
    // No @default: MySQL forbids a literal default on a JSON column (see the
    // note in db/mysql/migrations/20260728000000_panels).
    steps        Json
    status       AutomationRunStatus @default(RUNNING)
    ticketId     String?             @db.VarChar(19)
    triggerType  String              @db.VarChar(64)
    userId       String?             @db.VarChar(19)

    @@index([guildId, createdAt])
    @@index([automationId, createdAt])
    @@map("automationRuns")
}

// NULL on any of the columns marked "inheritable" means "use the server-wide
// default" — the matching column on `Guild`, and failing that a built-in from
// `src/lib/settings/inheritance.js`. That is why none of them carry a @default:
// Prisma fills a default in on every create, so a new category would always
// override and could never inherit.
//
// An *empty* value is not an absence. `[]` means "ping nobody", `0` means "slow
// mode off". Both are choices, both stop the chain, and only NULL inherits.
model Category {
    autoAssign       Boolean      @default(false)
    backupCategory   Category?    @relation(name: "CategoryBackup", fields: [backupCategoryId], references: [id], onDelete: SetNull)
    backupCategoryId Int?
    // The channel-name prefix while the last message is from the ticket author.
    // Inheritable; '' is a deliberate "no emoji", and both levels unset means
    // the feature is off — the ticket keeps showing its claimed/unclaimed emoji.
    awaitingStaffEmoji String?
    // Roles that prevent a member using this category. Checked before
    // `requiredRoles` and not bypassed by staff, matching `Guild.blocklist`.
    // Inheritable.
    blockedRoles     Json?
    channelMode      ChannelMode  @default(CHANNEL)
    channelName      String?      // inheritable
    // The channel-name prefix when a ticket is claimed. Inheritable; '' is a
    // deliberate "no emoji" and NULL asks the guild.
    claimedEmoji     String?
    claiming         Boolean      @default(false)
    // Only ever visible on THREAD/FORUM categories: a channel-mode ticket has
    // its channel deleted on close, so there is no name left to prefix.
    closedEmoji      String?
    createdAt        DateTime     @default(now())
    cooldown         Int?         // inheritable; 0 is an explicit "no cooldown"
    customTopic      String?
    description      String
    discordCategory  String       @db.VarChar(19)
    emoji            String
    enableFeedback   Boolean      @default(false)
    guild            Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
    guildId          String       @db.VarChar(19)
    id               Int          @id @default(autoincrement())
    image            String?
    memberLimit      Int?         // inheritable
    // Components v2 block layout for the ticket opening message. NULL means
    // "derive it from openingMessage", so a guild that never opens the block
    // editor keeps exactly the message it had before.
    messageLayout    Json?
    name             String
    openingMessage   String       @db.Text
    pingRoles        Json?        // inheritable
    primaryCategories Category[]  @relation("CategoryBackup")
    // { HIGH, MEDIUM, LOW, NONE }, merged per key rather than wholesale, so
    // overriding one priority does not detach the other three from the guild.
    priorityEmojis   Json?
    questions        Question[]
    ratelimit        Int?         // inheritable; 0 is an explicit "slow mode off"
    requiredRoles    Json?        // inheritable
    requireTopic     Boolean      @default(false)
    // Close without asking the member: staff confirm privately and the ticket
    // closes there and then, instead of a close request the member has to
    // accept. Inheritable, so NULL asks the guild — which is why it is nullable
    // rather than NOT NULL DEFAULT false like `staffChannel` above.
    skipCloseRequest Boolean?     // inheritable
    staffRoles       Json?        // inheritable
    // Also open a private staff-only thread or channel when a ticket opens here.
    // Boolean rather than nullable-and-inheritable on purpose: the three-state
    // trap `inheritance.js` exists to police (NULL asks the level above, false
    // is a decision) simply does not arise without a NULL, and a server-wide
    // default is an additive change if anyone wants one.
    staffChannel     Boolean      @default(false)
    // How to make it. NULL means the sensible default for the ticket's own mode:
    // a nested private thread for a CHANNEL ticket, a sibling private thread for
    // a THREAD one, and a private channel for a FORUM one. Never FORUM: a
    // private staff forum post is a contradiction, and the route refuses it.
    staffChannelMode ChannelMode?
    // Where to put it, overriding that default. A Discord category for a
    // channel-mode staff channel, a text channel for a thread.
    staffChannelParent String?    @db.VarChar(19)
    threadChannelId  String?      @db.VarChar(19)
    tickets          Ticket[]
    totalLimit       Int?         // inheritable

    @@map("categories")
    // The prefix while a ticket is open and unclaimed. Defaults to nothing,
    // which is what the bot did before this was configurable.
    unclaimedEmoji   String?
}

model Feedback {
    comment   String?  @db.Text
    createdAt DateTime @default(now())
    guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
    guildId   String   @db.VarChar(19)
    rating    Int
    ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
    ticketId  String   @id @db.VarChar(19)
    user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId    String?  @db.VarChar(19)

    @@map("feedback")
}

// The columns marked "category default" are the server-wide fallback for the
// identically-named column on `Category`. All are nullable with no @default:
// NULL here means "not set, use the built-in".
//
// `blockedRoles` and `blocklist` are different things and are easy to confuse.
// `blockedRoles` is the server-wide default for a category's role deny list, and
// a category can override it. `blocklist` is a guild-wide list of users and
// roles that may not open tickets at all; it has never been a category setting
// and does not inherit.
model Guild {
    autoClose         Int          @default(43200000)
    autoTag           Json         @default("[]")
    automations       Automation[]
    archive           Boolean      @default(true)
    awaitingStaffEmoji String?     // category default
    blockedRoles      Json?        // category default
    blocklist         Json         @default("[]")
    botAvatar         String?      @db.Text
    botBanner         String?      @db.Text
    botBio            String?      @db.Text
    botUsername       String?      @db.VarChar(255)
    categories        Category[]
    channelName       String?      // category default
    claimedEmoji      String?      // category default
    claimButton       Boolean      @default(false)
    closedEmoji       String?      // category default
    closeButton       Boolean      @default(false)
    closeReasonButton Boolean      @default(false)
    cooldown          Int?         // category default
    createdAt         DateTime     @default(now())
    disableDMs        Boolean      @default(false)
    errorColour       String       @default("Red")
    feedback          Feedback[]
    footer            String?      @default("Discord Tickets by eartharoid™ & egelhaus™")
    id                String       @id @db.VarChar(19)
    locale            String       @default("en-GB")
    logChannel        String?      @db.VarChar(19)
    memberLimit       Int?         // category default
    panels            Panel[]
    pingRoles         Json?        // category default
    priorityEmojis    Json?        // category default
    primaryColour     String       @default("#009999")
    ratelimit         Int?         // category default
    reopenWindow      Int          @default(0)
    requiredRoles     Json?        // category default
    skipCloseRequest  Boolean?     // category default
    staffRoles        Json?        // category default
    staleAfter        Int?
    successColour     String       @default("Green")
    tags              Tag[]
    tickets           Ticket[]
    totalLimit        Int?         // category default
    unclaimedEmoji    String?      // category default
    workingHours      Json         @default("[\"UTC\", [\"00:00\",\"23:59\"], [\"00:00\",\"23:59\"], [\"00:00\",\"23:59\"], [\"00:00\",\"23:59\"], [\"00:00\",\"23:59\"], [\"00:00\",\"23:59\"], [\"00:00\",\"23:59\"]]")

    @@map("guilds")
}

model Panel {
    // Category ids referenced by `layout`, derived server-side on every write so
    // the client cannot make it drift. Matches the Json-array convention already
    // used by pingRoles/staffRoles/blocklist; the trade-off is no FK cascade, so
    // a deleted category leaves a dangling id that the renderer skips.
    categories  Json     @default("[]")
    channelId   String   @db.VarChar(19)
    createdAt   DateTime @default(now())
    // Not a User relation: User rows only exist for ticket participants, and an
    // FK here would force connectOrCreate on every write.
    createdById String?  @db.VarChar(19)
    guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
    guildId     String   @db.VarChar(19)
    id          Int      @id @default(autoincrement())
    layout      Json
    // NULL until the panel has been posted, and again if its message is deleted
    // in Discord — the listeners null it so the dashboard can offer a re-send.
    messageId   String?  @db.VarChar(19)
    name        String   @db.VarChar(100)
    updatedAt   DateTime @updatedAt

    @@unique([messageId])
    @@index([guildId])
    @@map("panels")
}

model Question {
    answers     QuestionAnswer[]
    // Per-type extras that don't warrant a column each: `description` (the Label
    // description shown under the question in the modal), `channelTypes` for
    // CHANNEL_SELECT, `defaultChecked` for CHECKBOX, `content` for TEXT_DISPLAY.
    config      Json?
    createdAt   DateTime         @default(now())
    id          String           @id @default(uuid())
    category    Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    categoryId  Int
    label       String           @db.VarChar(45)
    maxLength   Int?             @default(4000)
    minLength   Int?             @default(0)
    options     Json             @default("[]")
    order       Int
    placeholder String?          @db.VarChar(100)
    required    Boolean          @default(true)
    style       Int              @default(2)
    type        QuestionType     @default(TEXT)
    value       String?          @db.Text

    @@map("questions")
}

model QuestionAnswer {
    createdAt  DateTime @default(now())
    id         Int      @id @default(autoincrement())
    ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
    ticketId   String   @db.VarChar(19)
    question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
    questionId String
    user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    userId     String   @db.VarChar(19)
    value      String?  @db.Text

    @@map("questionAnswers")
}

model Tag {
    content   String   @db.Text
    createdAt DateTime @default(now())
    guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
    guildId   String   @db.VarChar(19)
    id        Int      @id @default(autoincrement())
    name      String
    regex     String?

    @@unique([guildId, name])
    @@map("tags")
}

model Ticket {
    archivedChannels    ArchivedChannel[]
    archivedMessages    ArchivedMessage[]
    archivedRoles       ArchivedRole[]
    archivedUsers       ArchivedUser[]
    // Who the ticket is waiting on: 'STAFF' or 'USER', flipped by whoever sent
    // the last human message. NULL once the ticket closes, and on any ticket
    // that predates this column — see `naming.js#ticketState`, which treats
    // anything other than 'STAFF' as "not waiting on us".
    awaitingResponseFrom String?
    category            Category?         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    categoryId          Int?
    claimedBy           User?             @relation(name: "TicketsClaimedByUser", fields: [claimedById], references: [id])
    claimedById         String?           @db.VarChar(19)
    closedAt            DateTime?
    closedBy            User?             @relation(name: "TicketsClosedByUser", fields: [closedById], references: [id])
    closedById          String?           @db.VarChar(19)
    closedReason        String?           @db.Text
    createdAt           DateTime          @default(now())
    createdBy           User              @relation(name: "TicketsCreatedByUser", fields: [createdById], references: [id])
    createdById         String            @db.VarChar(19)
    // Channels an automation's "create a channel" node made during a run that
    // had this ticket, so closing it can take them down again. Nullable rather
    // than NOT NULL DEFAULT '[]' because MySQL cannot put a DEFAULT on a JSON
    // column; NULL reads as [].
    createdChannelIds   Json?
    deleted             Boolean           @default(false)
    // An emoji pinned to this ticket by `action.ticket.setEmoji` or /emoji. It
    // replaces the state emoji and survives claims, releases and moves; only an
    // automation, the command, or the ticket closing clears it. `scope` is
    // 'state' (keep the priority emoji) or 'all' (be the whole prefix).
    emojiOverride       String?
    emojiOverrideScope  String?
    feedback            Feedback?
    firstResponseAt     DateTime?
    guild               Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
    guildId             String            @db.VarChar(19)
    htmlTranscript      String?           @db.Text
    id                  String            @id @db.VarChar(19)
    lastMessageAt       DateTime?
    messageCount        Int?
    number              Int
    open                Boolean           @default(true)
    openingMessageId    String            @db.VarChar(19)
    pendingCloseAt      DateTime?
    pinnedMessageIds    Json              @default("[]")
    priority            String?
    referencedBy        Ticket[]          @relation("TicketsReferencedByTicket")
    referencesMessageId String?           @db.VarChar(19)
    referencesTicket    Ticket?           @relation(name: "TicketsReferencedByTicket", fields: [referencesTicketId], references: [id], onDelete: SetNull)
    referencesTicketId  String?           @db.VarChar(19)
    // The private staff thread or channel for this ticket, if it has one. Its
    // own column rather than an entry in `createdChannelIds`, because
    // /private-channel has to find it by id to stay idempotent.
    staffChannelId      String?           @db.VarChar(19)
    topic               String?           @db.Text
    questionAnswers     QuestionAnswer[]

    @@unique([guildId, number])
    @@map("tickets")
}

model User {
    createdAt       DateTime         @default(now())
    feedback        Feedback[]
    id              String           @id @db.VarChar(19)
    messageCount    Int              @default(0)
    ticketsCreated  Ticket[]         @relation("TicketsCreatedByUser")
    ticketsClosed   Ticket[]         @relation("TicketsClosedByUser")
    ticketsClaimed  Ticket[]         @relation("TicketsClaimedByUser")
    questionAnswers QuestionAnswer[]

    @@map("users")
}

enum AutomationRunStatus {
    RUNNING
    // Parked in a Temporal workflow, waiting on a flow.wait node.
    SUSPENDED
    SUCCESS
    FAILED
    // The graph short-circuited on a condition before any action ran.
    SKIPPED
    // The automation was edited, disabled or deleted while the run was parked.
    CANCELLED
}

enum ChannelMode {
    CHANNEL
    THREAD
    FORUM
}

enum QuestionType {
    // MENU is the string select. It predates the others and is kept under its
    // original name so no data migration is needed.
    MENU
    TEXT
    USER_SELECT
    ROLE_SELECT
    CHANNEL_SELECT
    MENTIONABLE_SELECT
    CHECKBOX
    CHECKBOX_GROUP
    RADIO_GROUP
    FILE_UPLOAD
    // Not an input: static markdown rendered in the modal, no answer stored.
    TEXT_DISPLAY
}
