# Excluded from the release tarball (rsync --exclude-from).
#
# What ships is what an operator needs to *run* the bot: src/ (including the
# dashboard bundle built by release-tarball.yml), db/, scripts/, dist/temporal
# built by CI, and the manifests. Development inputs do not — notably
# src/dashboard/src. Dropping src/dashboard/package.json is also what makes
# scripts/postinstall skip its dashboard build here: the bundle is already
# present and there are no sources to rebuild it from. Customising the
# dashboard means installing from git.
.git
.github
.claude
.husky
.vscode
node_modules
# Leading slash = the repository root only. Without it rsync matches at every
# level, which silently dropped src/user/ — the default config.yml the bot
# seeds DATA_DIR from, and without which it cannot start.
/out
/prisma
/user
/dist/temporal/tsconfig.tsbuildinfo
src/dashboard/src
src/dashboard/static
src/dashboard/node_modules
src/dashboard/.svelte-kit
src/dashboard/package.json
src/dashboard/package-lock.json
src/dashboard/svelte.config.js
src/dashboard/vite.config.js
# .js, not .cjs — the two entries here previously named `.cjs` and so never
# matched anything.
